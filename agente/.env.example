# Copie para .env (o .env NUNCA vai para o Git).

# Endereço do portal (HTTPS em produção)
PORTAL_URL=https://portal.seudominio.com.br

# Mesmo valor do AGENTE_TOKEN do .env do portal (gere com: php artisan portal:token-agente)
AGENTE_TOKEN=

# Domínio Folha nesta máquina
DOMINIO_EXE=C:\Contabil\contabil.exe

# Opcional: login automático da Domínio se ela estiver fechada (fica só nesta máquina)
DOMINIO_USUARIO=
DOMINIO_SENHA=

# Pasta onde a Rotina Automática da Domínio salva os PDFs (Extrato e Líquidos)
PASTA_RELATORIOS=C:\Robo\relatorios

# Intervalo entre ciclos (segundos)
INTERVALO_SEGUNDOS=30
